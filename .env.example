# MetaTrader 5 credentials — never commit the real .env
# The server.py on the Windows side reads these to log in.
MT5_DEMO_LOGIN=0
MT5_PASSWORD=replace_me
MT5_SERVER=Alfa-Forex-Demo
# Shared secret between the Linux bot and the Windows MT5 RPyC server.
NORNWEAVE_MT5_SECRET=replace_me_with_a_long_random_string
# Where the Linux bot finds the MT5 server.
MT5_HOST=192.168.1.100
MT5_PORT=18813
