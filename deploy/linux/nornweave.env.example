# NornWeaveForex bot environment (systemd EnvironmentFile).
# Installed to /etc/nornweave/nornweave.env with mode 0640, owned root:nornweave.
# Never commit the real file.

# Where the Windows-side MT5 RPyC server listens.
MT5_HOST=192.168.1.100
MT5_PORT=18813

# Shared secret; must match NORNWEAVE_MT5_SECRET on the Windows machine.
# The installer generates a random value when creating this file.
NORNWEAVE_MT5_SECRET=replace_me_with_a_long_random_string

# MT5 credentials. Only used when the bot is started WITHOUT --paper; the
# terminal is normally already logged in, in which case leave the login at 0.
MT5_DEMO_LOGIN=0
MT5_PASSWORD=
MT5_SERVER=Alfa-Forex-Demo
